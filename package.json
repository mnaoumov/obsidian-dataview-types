{
  "name": "@mnaoumov/obsidian-dataview",
  "version": "1.0.0",
  "description": "Working TypeScript types for the Obsidian Dataview plugin's API, plus its getAPI / isPluginEnabled helpers: a drop-in replacement for the obsidian-dataview npm package.",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "dataview",
    "typescript",
    "types"
  ],
  "homepage": "https://github.com/mnaoumov/obsidian-dataview-types#readme",
  "bugs": {
    "url": "https://github.com/mnaoumov/obsidian-dataview-types/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnaoumov/obsidian-dataview-types.git"
  },
  "license": "MIT",
  "author": "Michael Naumov",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib/esm/library.d.mts",
        "default": "./dist/lib/esm/library.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/library.d.cts",
        "default": "./dist/lib/cjs/library.cjs"
      }
    },
    "./data-index": {
      "import": {
        "types": "./dist/lib/esm/@types/data-index/index.d.mts"
      },
      "require": {
        "types": "./dist/lib/cjs/@types/data-index/index.d.cts"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/lib/esm/@types/*.d.mts"
      },
      "require": {
        "types": "./dist/lib/cjs/@types/*.d.cts"
      }
    }
  },
  "files": [
    "dist/",
    "!dist/*.tgz",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "jiti scripts/build.ts",
    "build:clean": "jiti scripts/build-clean.ts",
    "build:compile": "jiti scripts/build-compile.ts",
    "build:compile:typescript": "jiti scripts/build-compile-typescript.ts",
    "build:lib": "jiti scripts/build-lib.ts",
    "build:types": "jiti scripts/build-types.ts",
    "build:validate-declarations": "jiti scripts/build-validate-declarations.ts",
    "commit": "jiti scripts/commit.ts",
    "find-overexposed": "jiti scripts/find-overexposed.ts",
    "find-overexposed:fix": "jiti scripts/find-overexposed-fix.ts",
    "format": "jiti scripts/format.ts",
    "format:check": "jiti scripts/format-check.ts",
    "gate": "jiti scripts/gate.ts",
    "lint": "jiti scripts/lint.ts",
    "lint:fix": "jiti scripts/lint-fix.ts",
    "lint:md": "jiti scripts/lint-md.ts",
    "lint:md:fix": "jiti scripts/lint-md-fix.ts",
    "prepare": "jiti scripts/prepare.ts",
    "publish:npm": "jiti scripts/publish-npm.ts",
    "spellcheck": "jiti scripts/spellcheck.ts",
    "test": "jiti scripts/test.ts",
    "test:coverage": "jiti scripts/test-coverage.ts",
    "test:watch": "jiti scripts/test-watch.ts",
    "version": "jiti scripts/version.ts"
  },
  "overrides": {
    "@puppeteer/browsers": "^3.2.2",
    "@vitest/coverage-v8": "$@vitest/coverage-v8",
    "deepmerge-ts": "^8.0.2",
    "eslint": "$eslint",
    "eslint-plugin-import": "npm:eslint-plugin-import-x@^4.17.1",
    "fflate": "$fflate",
    "js-yaml": "4.3.2",
    "katex": "^0.18.2",
    "smol-toml": "^1.8.0",
    "typescript": "$typescript"
  },
  "dependencies": {
    "@types/luxon": "^3.7.5",
    "@types/parsimmon": "^1.10.9",
    "compare-versions": "^6.1.1",
    "localforage": "^1.10.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lezer/common": "1.5.2",
    "@mnaoumov/typescript-dev-toolkit": "^5.0.0",
    "@mnaoumov/typescript-test-toolkit": "^1.0.0",
    "@obsidian-typings/obsidian-public-latest": "^6.37.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "better-typescript-lib": "^2.12.0",
    "cspell": "^10.3.3",
    "czg": "^1.14.0",
    "dprint": "^0.57.4",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-tsdoc": "^0.5.3",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.0",
    "markdownlint-cli2": "^0.24.0",
    "nano-staged": "^1.0.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.0.1",
    "@codemirror/view": "^6.0.1",
    "@lezer/common": "^1.0.0",
    "@obsidian-typings/obsidian-public-latest": ">=6.0.0",
    "obsidian": ">=1.4.0"
  },
  "peerDependenciesMeta": {
    "@obsidian-typings/obsidian-public-latest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
